# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Anything VITE_-prefixed is bundled into the browser. Never put a secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend (server/) ──────────────────────────────────────────────────────
PORT=8787
APP_URL=http://localhost:5173

# JO1N ID — the identity provider.
JO1N_ISSUER=https://id.jo1n.com
JO1N_CLIENT_ID=artbank-web
# Plaintext secret. Its argon2 hash goes in JO1N ID's 040_artbank_client.sql.
JO1N_CLIENT_SECRET=
JO1N_REDIRECT_URI=http://localhost:8787/auth/callback
JO1N_AUDIENCE=artbank-api

# JO1N ID's discovery document currently advertises /api/v1/auth/oauth2/*
# while its routes are mounted at /oauth2/*. These overrides exist so we can
# point at whichever is correct without a code change; remove them once
# discovery and routing agree upstream.
# JO1N_AUTHORIZE_URL=
# JO1N_TOKEN_URL=
# JO1N_JWKS_URL=
# JO1N_REGISTER_URL=

# Supabase service role — bypasses RLS. Server-side only, never VITE_-prefixed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
